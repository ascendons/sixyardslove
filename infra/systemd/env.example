# Copy this file to /etc/ecom-backend/env on the EC2 instance.
# Fill in real values. This file must NOT be committed to git.
# Permissions: sudo chmod 600 /etc/ecom-backend/env

DB_URL=jdbc:postgresql://localhost:5432/syl_db
DB_USERNAME=syl_user
DB_PASSWORD=changeme

JWT_SECRET=generate-with-openssl-rand-base64-32

# Without domain: use CloudFront URL from setup-aws-cli.sh output
# With domain:    CORS_ORIGINS=https://sixyardslove.com,https://www.sixyardslove.com
CORS_ORIGINS=https://YOUR_CF_ID.cloudfront.net

GEOIP_DB_PATH=/opt/ecom-backend/GeoLite2-Country.mmdb

# Razorpay
# Dashboard → Settings → Webhooks → configure https://api.sixyardslove.com/api/webhooks/razorpay → copy secret
RZP_KEY_ID=rzp_live_XXXXXXXXXXXX
RZP_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX
RZP_WEBHOOK_SECRET=

# Shiprocket
# Dashboard → Settings → API → Webhooks → URL: https://api.sixyardslove.com/api/webhooks/fulfillment
# Set any strong secret there; put the same value below
SHIPROCKET_CHANNEL_ID=  # optional — omit to use Shiprocket account's default channel
SHIPROCKET_WEBHOOK_SECRET=

# SES email (us-east-1 after Route 53 migration)
AWS_REGION=us-east-1
EMAIL_FROM=noreply@sixyardslove.com
FRONTEND_BASE_URL=https://www.sixyardslove.com
